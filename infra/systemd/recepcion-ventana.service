[Unit]
Description=Suite Juviar: sincronización corta de recepción
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=suite
WorkingDirectory=/opt/suite/apps/api
EnvironmentFile=/etc/suite/recepcion.env
ExecStart=/opt/suite/.venv/bin/python -m suite_juviar.modulos.recepcion.integracion_oracle.worker ventana
TimeoutStartSec=240
