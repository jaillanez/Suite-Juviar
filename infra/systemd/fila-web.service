[Unit]
Description=Suite Juviar - fila de camiones
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suite
Group=suite
WorkingDirectory=/opt/suite-juviar
Environment=PYTHONPATH=/opt/suite-juviar:/opt/suite-juviar/apps/fila/src
EnvironmentFile=/etc/suite/fila.env
ExecStart=/opt/suite-juviar/.venv/bin/uvicorn fila_app.main:app --host 172.18.0.1 --port 8022 --proxy-headers --forwarded-allow-ips=172.18.0.0/16 --no-access-log
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
