[Unit]
Description=Suite Juviar - publicador de contactos a DMZ
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suite
Group=suite
WorkingDirectory=/opt/suite-juviar
Environment=PYTHONPATH=/opt/suite-juviar/apps/api/src
EnvironmentFile=/etc/suite/recepcion.env
EnvironmentFile=/etc/suite/contactos-publicador.env
ExecStart=/opt/suite-juviar/.venv/bin/python -m suite_juviar.workers.contactos_worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
